# Copy to .env and fill in.
GEMINI_API_KEY=AIza...          # Google AI Studio key (or OPENAI_API_KEY for gpt-* models)
OWNER_NAME=Your Name

# Models: cheap one for triage, strong one for writing. Change freely.
TRIAGE_MODEL=gemini-flash-lite-latest
DRAFT_MODEL=gemini-flash-latest
# Tried in order if the draft model is busy. "lite" models are used only from LITE_AFTER_HOUR
# (earlier, the draft waits for the next hourly run). Leave empty to disable fallbacks.
DRAFT_FALLBACKS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-flash-lite-latest
LITE_AFTER_HOUR=17

# Optional tuning (defaults shown)
# MAX_ATTEMPTS=3
# GMAIL_QUERY=in:inbox category:primary newer_than:2d -from:me
# MAX_FETCH=50
# BODY_CHARS=2500        # max chars of an email body sent to the writer
# TRIAGE_CHARS=500       # max chars per email sent to triage
# TRIAGE_BATCH=20        # emails classified per triage call
# WORKERS=6              # parallel drafts
# REVIEW_PORT=8765
# REVIEW_TIMEOUT_MIN=300 # undecided drafts roll over to the next day
# AGENT_DATA_DIR=        # defaults to ./data
